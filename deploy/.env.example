# Runtime environment for the stockahead container.
# Real values live only in Coolify (app → Environment Variables). Never commit them.

# Always "prod" on the server.
SPRING_PROFILES_ACTIVE=prod

# Internal connection to the Coolify-managed postgres:18 resource (never public).
SPRING_DATASOURCE_URL=jdbc:postgresql://<pg-uuid>:5432/stockahead
SPRING_DATASOURCE_USERNAME=stockahead
SPRING_DATASOURCE_PASSWORD=

# One-time token for the first-run /setup screen (S3). Generate with: openssl rand -hex 24
STOCKAHEAD_SETUP_TOKEN=
